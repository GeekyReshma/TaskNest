# SQLite (local) or PostgreSQL connection string
DATABASE_URL="file:./dev.db"

# HTTP port for the NestJS API
PORT=4000

# Secret used to sign guest JWT sessions (change in production)
JWT_SECRET="change-me-to-a-long-random-string"

# Allowed frontend origin for CORS (required in production)
FRONTEND_URL="http://localhost:3000"

# Set to "production" on deployed hosts
NODE_ENV="development"
